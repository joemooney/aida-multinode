From 84aed8f382364a7bb00743367605a20b1502dd34 Mon Sep 17 00:00:00 2001
From: Joe Mooney <joe.mooney@gmail.com>
Date: Sun, 15 Nov 2026 14:53:41 -0700
Subject: [PATCH 1/6] [AI:antigravity] fix(provenance): honor AIDA_USER in
 default_author() fallback chain (BUG-MN-006)

---
 aida-core/src/provenance.rs | 1 +
 1 file changed, 1 insertion(+)

diff --git a/aida-core/src/provenance.rs b/aida-core/src/provenance.rs
index 3331f8c5be3..8c226e5a180 100644
--- a/aida-core/src/provenance.rs
+++ b/aida-core/src/provenance.rs
@@ -398,6 +398,7 @@ fn stamp_write_impl(
 // trace:STORY-1674 | ai:claude
 pub fn default_author() -> String {
     std::env::var("AIDA_AUTHOR")
+        .or_else(|_| std::env::var("AIDA_USER"))
         .or_else(|_| std::env::var("USER"))
         .or_else(|_| std::env::var("USERNAME")) // Windows fallback
         .unwrap_or_else(|_| "Unknown".to_string())
